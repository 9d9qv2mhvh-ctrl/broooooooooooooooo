local function cleanupFly()
    -- Disconnect all connections
    for _, conn in ipairs(flyConnections) do
        if conn and conn.Disconnect then
            conn:Disconnect()
        end
    end
    flyConnections = {}
    
    -- Remove fly objects
    if flyVelocity and flyVelocity.Parent then
