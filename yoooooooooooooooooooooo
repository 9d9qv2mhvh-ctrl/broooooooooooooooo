                    _active = false
                    if carPunchToggleCtrl and carPunchToggleCtrl.SetValue then pcall(function() carPunchToggleCtrl:SetValue(false) end) end; return
                end
                local initCar = nil
                for _, entry in pairs(cars) do if not entry.seat.Occupant then initCar = entry; break end end
                if initCar then
                    pcall(function() initCar.model:SetPrimaryPartCFrame(hrp.CFrame * CFrame.new(0,0,-5)) end); task.wait(0.2)
