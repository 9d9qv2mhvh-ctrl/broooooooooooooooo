    Flag = "Aimbot",
    Callback = function(Value)
        AimbotEnabled = Value
        if Value then
            WindUI:Notify({ Title = "Aimbot", Content = "Enabled! Aiming at nearest enemy!", Duration = 2, Icon = "target" })
            local aimLoop
            aimLoop = game:GetService("RunService").RenderStepped:Connect(function()
                if not AimbotEnabled then
                    aimLoop:Disconnect()
                    return
                end
                
                if tick() % 0.1 < 0.016 then
                    AimbotTarget = getClosestEnemy()
                end
                
                updateAimbotCamera()
            end)
        else
            WindUI:Notify({ Title = "Aimbot", Content = "Disabled", Duration = 2, Icon = "x" })
            AimbotTarget = nil
        end
    end
})

