        while AutoBackpackDupeEnabled do
            local success, message = performSafeDupe()
            if success then
                F9Notification(message); task.wait(1)
                autoGrabWeaponsForSafe()
                local _, storeMsg = autoStoreWeaponsToBackpack()
                F9Notification(storeMsg)
            else
                F9Notification(message)
            end
            if AutoBackpackDupeEnabled then task.wait(5) end
        end
    end)
end

local function stopAutoTrunkDupeMacro()
    AutoTrunkDupeEnabled = false
    if AutoTrunkDupeThread then task.cancel(AutoTrunkDupeThread); AutoTrunkDupeThread = nil end
    F9Notification("🛑 Auto Trunk Dupe STOPPED!")
end

local function startAutoTrunkDupeMacro()
    if AutoTrunkDupeEnabled then stopAutoTrunkDupeMacro(); return end
    AutoTrunkDupeEnabled = true
    F9Notification("🚗 Auto Trunk Dupe STARTED!")
    AutoTrunkDupeThread = task.spawn(function()
        while AutoTrunkDupeEnabled do
            local success, message = performSafeDupe()
            if success then
                F9Notification(message); task.wait(1)
                autoGrabWeaponsForSafe()
                local _, trunkMsg = autoStoreWeaponsToTrunk()
                F9Notification(trunkMsg)
            else
                F9Notification(message)
            end
            if AutoTrunkDupeEnabled then task.wait(5) end
        end
    end)
end

