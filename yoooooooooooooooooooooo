                                return true, "Stored " .. SafeTargetWeapon .. " in default safe"
                            end
                        end
                    end
                end
                return false, "No safe found within " .. maxDistance .. " studs"
            end
        else
            return false, "Not storing (Have " .. weaponCount .. " copies, need exactly 2)"
        end
    end
    return false, "Safe remote not found"
end

