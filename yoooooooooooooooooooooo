                    _active = false
                    if carPunchToggleCtrl and carPunchToggleCtrl.SetValue then pcall(function() carPunchToggleCtrl:SetValue(false) end) end; return
                end
                local cars = {}
                for _, v in pairs(civCars:GetChildren()) do
                    local seat = v:FindFirstChild("DriveSeat")
                    if seat then
                        if not v.PrimaryPart then v.PrimaryPart = v:FindFirstChild("#Weight", true) or v:FindFirstChildWhichIsA("BasePart") end
                        if v.PrimaryPart then table.insert(cars, { model = v, seat = seat }) end
                    end
