local function buildFlyMobileGui()
    destroyFlyMobileGui()
    if not UIS.TouchEnabled then return end

    flyMobileGui = Instance.new("ScreenGui")
    flyMobileGui.Name = "FlyMobileDpad"
    flyMobileGui.ResetOnSpawn = false
    flyMobileGui.DisplayOrder = 9997
    flyMobileGui.IgnoreGuiInset = true
    flyMobileGui.Parent = CoreGui

    local function Btn(label, xScale, yOffset)
        local b = Instance.new("TextButton", flyMobileGui)
        b.AnchorPoint = Vector2.new(0.5, 1)
        b.Size = UDim2.new(0, 65, 0, 65)
        b.Position = UDim2.new(xScale, 0, 1, yOffset)
        b.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        b.BackgroundTransparency = 0.2
        b.Text = label
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.TextSize = 28
        b.Font = Enum.Font.GothamBold
        b.BorderSizePixel = 0
        b.ZIndex = 10
        b.AutoButtonColor = false
        Instance.new("UICorner", b).CornerRadius = UDim.new(0.3, 0)
        return b
    end

    local fwdBtn  = Btn("▲", 0.15, -240)
    local backBtn = Btn("▼", 0.15, -100)
    local leftBtn = Btn("◄", 0.08, -170)
    local rightBtn = Btn("►", 0.22, -170)

    local function wire(btn, key)
        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then
                if not carFlyEnabled then
                    btn.BackgroundTransparency = 0.7
                    task.delay(0.12, function()
                        if btn and btn.Parent then
                            btn.BackgroundTransparency = 0.2
                        end
                    end)
                    return
                end
                flyMobile[key] = true
                btn.BackgroundTransparency = 0.05
            end
        end)
        btn.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then
                flyMobile[key] = false
                btn.BackgroundTransparency = 0.2
            end
        end)
    end

    wire(fwdBtn, "fwd")
    wire(backBtn, "back")
    wire(leftBtn, "left")
    wire(rightBtn, "right")
end

local function CarFlyCleanup()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
end

local function CarFlySetup()
    CarFlyCleanup()
    if not carFlyEnabled then return end

    local char = LP.Character
    if not char then return end

    hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    seat = hum.SeatPart
    if not seat or not seat:IsA("VehicleSeat") then return end

    car = seat.Parent
    if not car then return end

    root = car.PrimaryPart
    if not root then return end

    lastCar = car

    for _, v in ipairs(car:GetChildren()) do
        if v:IsA("BasePart") and not v.Name:lower():find("wheel") then
            v.CanCollide = false
        end
    end

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 25000
    bg.D = 1500
    bg.CFrame = root.CFrame
    bg.Parent = root
end

task.spawn(function()
    while true do
        task.wait(0.2)

        local char = LP.Character
        if not char then continue end

        local h = char:FindFirstChildWhichIsA("Humanoid")
        if not h then continue end

        local currentSeat = h.SeatPart

        if currentSeat and currentSeat:IsA("VehicleSeat") then
            if currentSeat.Parent ~= lastCar then
                CarFlySetup()
            end
        else
            if lastCar then
                CarFlyCleanup()
                lastCar = nil
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if not carFlyEnabled then
        CarFlyCleanup()
        return
    end

    if not hum or hum.SeatPart ~= seat then return end
    if not root or not bv or not bg then CarFlySetup() return end

    local speed = carFlySpeed or 120
    local cam = workspace.CurrentCamera
    local camCF = cam.CFrame
    local camLook = camCF.LookVector
    local camRight = camCF.RightVector

    if not UIS.TouchEnabled then
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            bg.CFrame = CFrame.lookAt(root.Position, root.Position + camLook)
        end

        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move += camLook end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camLook end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camRight end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move += camRight end

        if move.Magnitude > 0 then
            bv.Velocity = move.Unit * speed
        else
            bv.Velocity = Vector3.zero
        end

    else
        bg.CFrame = CFrame.lookAt(root.Position, root.Position + camLook)

        local move = Vector3.zero
        if flyMobile.fwd then move += camLook end
        if flyMobile.back then move -= camLook end
        if flyMobile.left then move -= camRight end
        if flyMobile.right then move += camRight end

        local vertical = camLook.Y
        local velocity =
            (move * speed) +
            (Vector3.new(0, vertical, 0) * speed)

        if velocity.Magnitude > 0 then
            bv.Velocity = velocity
        else
            bv.Velocity = Vector3.zero
        end
    end
end)

