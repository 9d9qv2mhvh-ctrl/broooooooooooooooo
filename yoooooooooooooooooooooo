local animationTracks = {}

local function PlayAnimationOnTarget(animationId)
    if not SelectedPlayer or not SelectedPlayer.Character then
        WindUI:Notify({ Title = "Animation", Content = "No target selected", Duration = 2, Icon = "alert" })
        return
    end
    
    pcall(function()
        local targetChar = SelectedPlayer.Character
        local targetHumanoid = targetChar:FindFirstChildWhichIsA("Humanoid")
        
        if not targetHumanoid then return end
        
        -- Stop any existing animations
        for _, track in ipairs(animationTracks) do
            pcall(function() if track and track.Parent then track:Stop() end end)
        end
        animationTracks = {}
        
        -- Get or create animator
        local animator = targetHumanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = targetHumanoid
            task.wait(0.05)
        end
        
        -- Create animation
        local animation = Instance.new("Animation")
        animation.AnimationId = animationId
        
        -- Load and play animation
        pcall(function()
            local track = animator:LoadAnimation(animation)
            if track then
                track.Looped = true
                track:Play()
                track.Speed = 1
                table.insert(animationTracks, track)
                WindUI:Notify({ Title = "✅ Animation", Content = "Playing on " .. SelectedPlayer.Name, Duration = 2, Icon = "play" })
                
                -- Keep animation playing
                task.spawn(function()
                    while track and track.Parent and track.IsPlaying do
                        task.wait(1)
                    end
                end)
            end
        end)
    end)
end

local function StopAllAnimations()
    pcall(function()
        for _, track in ipairs(animationTracks) do
            if track and track.Parent then
                track:Stop()
            end
        end
        animationTracks = {}
        WindUI:Notify({ Title = "⏹️ Animation", Content = "All animations stopped", Duration = 2, Icon = "stop-circle" })
    end)
end

