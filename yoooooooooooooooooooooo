local rainbowTrailEnabled = false
local rainbowTrail = nil
local trailAtt0 = nil
local trailAtt1 = nil
local trailHue = 0
local trailLoop = nil

local function createRainbowTrail()
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if rainbowTrail then pcall(function() rainbowTrail:Destroy() end) end
    if trailAtt0   then pcall(function() trailAtt0:Destroy()   end) end
    if trailAtt1   then pcall(function() trailAtt1:Destroy()   end) end
    trailAtt0 = Instance.new("Attachment")
    trailAtt0.Position = Vector3.new(0, 1, 0)
    trailAtt0.Parent = hrp
    trailAtt1 = Instance.new("Attachment")
    trailAtt1.Position = Vector3.new(0, -1, 0)
    trailAtt1.Parent = hrp
    rainbowTrail = Instance.new("Trail")
    rainbowTrail.Attachment0 = trailAtt0
    rainbowTrail.Attachment1 = trailAtt1
    rainbowTrail.Lifetime    = 0.6
    rainbowTrail.MinLength   = 0
    rainbowTrail.FaceCamera  = true
    rainbowTrail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    rainbowTrail.Color = ColorSequence.new(Color3.fromHSV(0, 1, 1))
    rainbowTrail.LightEmission  = 1
    rainbowTrail.LightInfluence = 0
    rainbowTrail.Parent = hrp
end

local function removeRainbowTrail()
    pcall(function() if rainbowTrail then rainbowTrail:Destroy() end end)
    pcall(function() if trailAtt0    then trailAtt0:Destroy()    end end)
    pcall(function() if trailAtt1    then trailAtt1:Destroy()    end end)
    rainbowTrail = nil; trailAtt0 = nil; trailAtt1 = nil
end

PlayerTab:Toggle({
    Title = "Rainbow Trail",
    Default = false,
    Callback = function(state)
        rainbowTrailEnabled = state
        if state then
            createRainbowTrail()
            LocalPlayer.CharacterAdded:Connect(function()
                if rainbowTrailEnabled then task.wait(1); createRainbowTrail() end
            end)
            trailLoop = RunService.Heartbeat:Connect(function()
                if not rainbowTrailEnabled then
                    trailLoop:Disconnect(); trailLoop = nil; return
                end
                if not rainbowTrail or not rainbowTrail.Parent then
                    createRainbowTrail(); return
                end
                trailHue = (trailHue + 0.006) % 1
                local c1 = Color3.fromHSV(trailHue,              1, 1)
                local c2 = Color3.fromHSV((trailHue + 0.33) % 1, 1, 1)
                local c3 = Color3.fromHSV((trailHue + 0.66) % 1, 1, 1)
                rainbowTrail.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,   c1),
                    ColorSequenceKeypoint.new(0.5, c2),
                    ColorSequenceKeypoint.new(1,   c3)
                })
            end)
            WindUI:Notify({ Title = "Trail", Content = "Rainbow Trail enabled!", Duration = 2, Icon = "check" })
        else
            if trailLoop then trailLoop:Disconnect(); trailLoop = nil end
            removeRainbowTrail()
            WindUI:Notify({ Title = "Trail", Content = "Rainbow Trail disabled!", Duration = 2, Icon = "x" })
        end
    end
})

