        local rootPart = char:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        end

        task.wait(0.1)
        seat:Sit(hum)
    end
})

